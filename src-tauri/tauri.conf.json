{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Studio",
  "version": "0.1.0",
  "identifier": "ai.relaystudio.client",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:4174",
    "beforeDevCommand": "python3 -m http.server 4174 --directory app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["resources/runtimes/*", "resources/mcp/*"]
  }
}
