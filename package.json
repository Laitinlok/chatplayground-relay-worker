{
  "name": "chatplayground-relay",
  "version": "0.2.0",
  "description": "OpenAI-compatible Cloudflare Worker relay for chatplayground.ai (BYOK, stateless)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write src/",
    "lint": "biome lint src/",
    "check": "biome check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:dev": "npx tauri dev --config src-tauri/tauri.conf.json",
    "native:build:linux": "npx tauri build --config src-tauri/tauri.conf.json --bundles appimage",
    "native:build:android": "npx tauri android build --apk"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "chatplayground",
    "openai",
    "relay"
  ],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
